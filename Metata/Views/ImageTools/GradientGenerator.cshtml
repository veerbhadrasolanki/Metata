@{
}

<div class="ml-10 pt-5 flex">
    <div style="background-color:#15b02a; border-radius:25%;" class="flex flex-col items-center justify-center w-10 h-10 mr-4">
        <a href="/ImageTools/GradientGenerator" class="relative block">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008z" />
            </svg>
        </a>
    </div>
    <a href="/ImageTools/GradientGenerator">
        <div class="site-title font-bold  flex-col">Gradient Color Generator</div>
    </a>
</div>
<div class="container-fluid pt-5 pl-5 pr-5">
    <div class="wrapper">
        <div class="container-sidebar">
            <div>
                <nav>
                    <ul>
                        <li><a class="list-a" href="/dev/">Dev Tools</a></li>
                        <li><a class="list-a" href="/math/">Math Tools</a></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="container-content">
            <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 lg:h-2/4 gap-y-1 justify-items-stretch items-center mx-auto bg-white rounded-lg shadow dark:bg-gray-800">
                <div class=" gap-px	 flex flex-col  w-5/6 h-5/6 mx-auto container-color" for="bgcolor" style="background-image: linear-gradient(to bottom, #a2697a,#4f8b8a);">
                </div>
                <div class=" gap-px	 flex flex-col  w-5/6 mx-auto">
                    <div class="color">
                        <input type="color" id="color1" value="#00bfa5">
                        <input type="color" id="color2" value="#00332e">
                    </div>

                    <div class="directions">

                        <button class="active" onclick="setGradientDirection('to bottom',this)">
                            <ion-icon name="arrow-down-outline"></ion-icon>
                        </button>


                        <button onclick="setGradientDirection('to top',this)">
                            <ion-icon name="arrow-up-outline"></ion-icon>
                        </button>


                        <button onclick="setGradientDirection('to right',this)">
                            <ion-icon name="arrow-forward-outline"></ion-icon>
                        </button>


                        <button onclick="setGradientDirection('to left',this)">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                        </button>




                        <button class="rotate" onclick="setGradientDirection('to top right',this)">
                            <ion-icon name="arrow-down-outline"></ion-icon>
                        </button>


                        <button class="rotate" onclick="setGradientDirection('to bottom left',this)">
                            <ion-icon name="arrow-up-outline"></ion-icon>
                        </button>


                        <button class="rotate" onclick="setGradientDirection('to bottom right',this)">
                            <ion-icon name="arrow-forward-outline"></ion-icon>
                        </button>


                        <button class="rotate" onclick="setGradientDirection('to top left',this)">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                        </button>

                    </div>

                    <div class="result">
                        <textarea class="code" readonly></textarea>
                        <button class="random">Generate Random</button>
                        <button class="copy">Copy</button>
                        <button type="button" class="ss1" style="background-color: #0077cc;">Download</button>
                    </div>



                </div>
            </div>
        </div>

    </div>
</div>
<script>
    
// html 2 canvas 
document.querySelector('.ss1').addEventListener('click', function () {
    html2canvas(document.querySelector('.container-color'), {
        onrendered: function (canvas) {
            // document.body.appendChild(canvas);
            return Canvas2Image.saveAsPNG(canvas);
        }
    });
});
</script>