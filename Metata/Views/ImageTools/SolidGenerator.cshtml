<div class="container-fluid pt-5 pl-5 pr-5">
    <div class="wrapper">
        <div class="container-sidebar">
            <div>
                <nav>
                    <ul>
                        <li><a class="list-a" href="/dev/">Dev Tools</a></li>
                        <li><a class="list-a" href="/math/">Math Tools</a></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="container-content">
            <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 lg:h-2/4 gap-y-1 justify-items-stretch items-center mx-auto bg-white rounded-lg shadow dark:bg-gray-800">
                <div id="randomColor" class=" gap-px flex flex-col w-5/6 h-5/6 mx-auto container-option" for="bgcolor" style="background-color:#538f15;">
                </div>
                <div class=" gap-px	 flex flex-col  w-5/6 mx-auto">
                    <div class="color">
                        <input type="color" id="bgcolor" value="#538f15" onchange="test(this)" />
                    </div>


                    <div class="resultone">
                        <textarea class="codeone" id="lcolorcode" placeholder="#538f15" readonly>#538f15</textarea>
                        <button class="randomone" onclick="generaterandom()">Generate Random</button>
                        <button class="copyone" onclick="copycmd()">Copy</button>
                        <button type="button" class="ss" style="background-color: #0077cc;">Download</button>
                    </div>

                </div>
            </div>
        </div>


    </div>
</div>