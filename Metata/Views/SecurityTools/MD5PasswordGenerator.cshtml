<div class="ml-10 pt-5 flex">
    <div style="background-color:#5527b2; border-radius:25%;" class="flex flex-col items-center justify-center w-10 h-10 mr-4">
        <a href="/SecurityTools/MD5PasswordGenerator" class="relative block">
         <svg xmlns="http://www.w3.org/2000/svg" style="color:#fff;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
</svg>


        </a>
    </div>
    <a href="/SecurityTools/MD5PasswordGenerator">
        <div class="site-title font-bold  flex-col">MD5 Password Generator</div>
    </a>
</div>
<div class="container-fluid pt-5 pl-5 pr-5">
    <div class="wrapper">
        <div class="container-sidebar">
            <div>
                <nav>
                    <ul>
                        <li><a class="list-a" href="/dev/">Dev Tools</a></li>
                        <li><a class="list-a" href="/math/">Math Tools</a></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="container-content">
            <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 lg:h-2/4 gap-y-1 justify-items-stretch items-center mx-auto bg-white rounded-lg shadow dark:bg-gray-800">
                <div class=" gap-px	 flex flex-col  w-5/6 mx-auto">
                    <label for="message" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Enter Your String Here...</label>
                   <div class="input-box">
                        <input id="input-box" type="text">
                    </div>
                    <label for="message" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">MD5 Encoding</label>
                    <div class="password-box input-box">
                        <input id="output" type="text" disabled>
                        <span class="material-symbols-rounded copywithme" onclick="copymd5Password()">
                            <svg style="margin-top:10px;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0118 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3l1.5 1.5 3-3.75" />
                            </svg>
                        </span>
                    </div>
                    @*<div class="pass-indicator"></div>*@
                </div>
                <div class=" gap-px	 flex flex-col  w-5/6 mx-auto">
                    <div class="pass-length">
                       @* <div class="details">
                            <label class="title">Password Length</label>
                            <span></span>
                        </div>
                        <div class="range-box">
                            <input type="range" min="6" max="40" value="8" />
                            <span class="slider-number" style="display:none;">8</span>
                        </div>*@
                        <button id="md5" class="generate-btn generate-button">Generate Password</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>